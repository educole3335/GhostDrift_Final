theme_override_font_sizes/normal_font_size = 19
bbcode_enabled = true
text = "[b][color=yellow]CONTROLES[/color][/b]

[color=yellow]A / ←[/color]    Moverse izquierda
[color=yellow]D / →[/color]    Moverse derecha
[color=yellow]Espacio / W[/color]    Saltar
[color=yellow]Z[/color]    Atacar (Z)
[color=yellow]X[/color]    Anclar sombra  /  Intercambiar con ella
[color=yellow]Shift[/color]    Correr
[color=yellow]Escape[/color]    Pausa
[color=yellow]F11[/color]    Pantalla completa

[b][color=cyan]MECÁNICA DE SOMBRA[/color][/b]
Pulsa X para anclar tu sombra en el suelo.
Pulsa X de nuevo para teletransportarte a ella.
La barra morada indica la energía restante.

[b][color=gold]SISTEMA DE ESTRELLAS[/color][/b]
[color=gold]⭐⭐⭐[/color]  Sin muertes, pocos golpes, cristales recogidos, tiempo rápido
[color=gold]⭐⭐[/color]    Un criterio fallido
[color=gold]⭐[/color]      Dos criterios fallidos
[color=gray]☆☆☆[/color]   Completado pero con penalización máxima

[b][color=violet]OBJETIVO DE CADA NIVEL[/color][/b]
Elimina [b]todos[/b] los esqueletos → la puerta EXIT se desbloquea → ¡avanza!"

